# =================================
# Environment Configuration Template
# Copy this file to .env and fill in your actual values
# =================================

# =================================
# Model API Configuration
# =================================

# OpenRouter API (for remote models)
# Get your API key from: https://openrouter.ai/
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Your site URL for OpenRouter rankings
SITE_URL=https://your-domain.com

# Local Model Server (for self-hosted models)
# Uncomment and configure if using local model server like VLLM
# LOCAL_MODEL_BASE_URL=http://localhost:8000/v1
# LOCAL_MODEL_API_KEY=EMPTY

# =================================
# Model Selection
# =================================

# Evaluation models (comma-separated)
# Option 1: Speed optimized - faster evaluation (recommended for large datasets)
CUSTOM_JUDGER_MODELS=deepseek/deepseek-chat-v3.1:free,qwen/qwen3-235b-a22b:free,openai/gpt-oss-20b:free

# Option 2: Stability optimized - verified long-term stability
# CUSTOM_JUDGER_MODELS=deepseek/deepseek-chat-v3.1:free,qwen/qwen3-235b-a22b:free,google/gemma-2-9b-it:free

# Option 2: Use local models (uncomment if using local server)
# CUSTOM_JUDGER_MODELS=local-model-1,local-model-2,local-model-3

# Option 3: Mix local and remote models
# CUSTOM_JUDGER_MODELS=local-model,deepseek/deepseek-chat-v3.1:free,openai/gpt-4o-mini

# =================================
# File Paths
# =================================

# Input directories (relative to project root)
RESPONSE_ROOT=NesCodeSecExamples/src/main/java/com/Scenario1/output
PROMPT_ROOT=NesCodeSecExamples/src/main/java/com/Scenario1/evaluation

# Output file for evaluation results
EVALUATION_OUTPUT_FILE=evaluation_results.json

# =================================
# Model Parameters
# =================================

# Model temperature (0.0 = deterministic, 1.0 = creative)
MODEL_TEMPERATURE=0.1

# Maximum tokens per response
MAX_TOKENS=80

# Request timeout in seconds
REQUEST_TIMEOUT=45

# Number of retry attempts for failed requests
MAX_RETRIES=2

# =================================
# Rate Limiting & Debounce
# =================================

# Delay between each API request (in seconds)
# Increase this if you still get rate limits
REQUEST_DELAY=5.0

# How long to wait when hitting 429 rate limit (in seconds)  
# Should be longer than the rate limit reset window
RATE_LIMIT_WAIT=70

# =================================
# Logging & Debug
# =================================

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Enable detailed request logging (true/false)
DEBUG_REQUESTS=false

# Save request/response logs to file (true/false)
SAVE_LOGS=false
LOG_FILE=evaluation.log