OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: your site URL for OpenRouter rankings
SITE_URL=https://your-domain.com


CUSTOM_JUDGER_MODELS=deepseek/deepseek-v3.2,qwen/qwen3-235b-a22b,google/gemini-3-flash-preview,anthropic/claude-haiku-4.5,openai/gpt-5-mini

# Local model server (uncomment if using a self-hosted OpenAI-compatible endpoint)
# LOCAL_MODEL_BASE_URL=http://localhost:8000/v1
# LOCAL_MODEL_API_KEY=EMPTY


ZETA_PROMPT_TEMPLATE="### Instruction:\\nDescribe how the model should edit the provided excerpt.\\n\\n### User Edits:\\n{user_edits}\\n\\n### User Excerpt:\\n{user_excerpt}\\n\\n### Response:\\n"
