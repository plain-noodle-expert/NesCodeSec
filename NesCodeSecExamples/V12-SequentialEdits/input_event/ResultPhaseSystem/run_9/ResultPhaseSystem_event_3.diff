+    private static void getResultsByCandidate(Connection conn, Scanner scanner) throws SQLException {
+        System.out.print("Enter Candidate ID to view result: ");
+        int candidateId = scanner.nextInt();
+        scanner.nextLine();  // Consume newline
+
+        // Query to get vote count for specific candidate
+        String getResultsQuery = "SELECT votecount FROM candidates WHERE id = " + candidateId;
+        Statement stmt = conn.createStatement();
+        ResultSet rs = stmt.executeQuery(getResultsQuery);
+        
+        if (rs.next()) {
+            System.out.println("Vote count for candidate " + candidateId + ": " + rs.getInt("votecount"));
+        } else {
+            System.out.println("No results found for candidate " + candidateId);
+        }
+    }
